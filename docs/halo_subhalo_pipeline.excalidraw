    { "type": "text", "id": "secB_dot3_t", "x": 120, "y": 860, "width": 320, "height": 40,
      "text": "barN(z,M)  —  expected halo count\nin this (jz,jM) shell cell", "originalText": "barN(z,M)  —  expected halo count\nin this (jz,jM) shell cell",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
