    { "type": "rectangle", "id": "secD_evid", "x": 60, "y": 2030, "width": 1230, "height": 210,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 23071, "version": 1, "versionNonce": 23072, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "secD_evid_t", "x": 80, "y": 2046, "width": 1190, "height": 180,
      "text": "delta_c(z_f) = delta_c(z) + w_f sqrt(Delta sigma^2)      w_f = sqrt(2 ln(1+alpha_f)),  alpha_f = 0.815 e^-0.25 2^0.707   [Giocoli+2007]\n\nN_tau(z,z_f) = integral_z^zf  6.006 sqrt(Delta_vir(z')/178) / (1+z') dz'\nDelta_vir(z) = 18 pi^2 + 82 d - 39 d^2,  d = Omega_M(z) - 1   [Bryan-Norman 1998 virial overdensity]\n\nf_s = 0.3563 * N_tau^-0.6 - 0.075     [JvdB14 eq. 26, all-orders SHMF]",
      "originalText": "delta_c(z_f) = delta_c(z) + w_f sqrt(Delta sigma^2)      w_f = sqrt(2 ln(1+alpha_f)),  alpha_f = 0.815 e^-0.25 2^0.707   [Giocoli+2007]\n\nN_tau(z,z_f) = integral_z^zf  6.006 sqrt(Delta_vir(z')/178) / (1+z') dz'\nDelta_vir(z) = 18 pi^2 + 82 d - 39 d^2,  d = Omega_M(z) - 1   [Bryan-Norman 1998 virial overdensity]\n\nf_s = 0.3563 * N_tau^-0.6 - 0.075     [JvdB14 eq. 26, all-orders SHMF]",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
