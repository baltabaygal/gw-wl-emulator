    { "type": "text", "id": "secI_note", "x": 60, "y": 4760, "width": 1400, "height": 50,
      "text": "This runs once per ray-per-host encounter; a full realization sums it over every halo drawn in section B along the line of sight to z_s,\nplus filaments and the weak/clustering background, to build one lnmu sample.", "originalText": "This runs once per ray-per-host encounter; a full realization sums it over every halo drawn in section B along the line of sight to z_s,\nplus filaments and the weak/clustering background, to build one lnmu sample.",
