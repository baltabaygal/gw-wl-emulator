      "roundness": {"type": 3} },
    { "type": "text", "id": "secD_shmf_t", "x": 80, "y": 2300, "width": 550, "height": 100,
      "text": "evolved SHMF (JvdB14 eq. 22):\ndN/dln(psi) = gamma~ * psi^alpha * exp(-beta psi^omega)\npsi = m/M,  (alpha,beta,omega) = (-0.82, 50, 4)", "originalText": "evolved SHMF (JvdB14 eq. 22):\ndN/dln(psi) = gamma~ * psi^alpha * exp(-beta psi^omega)\npsi = m/M,  (alpha,beta,omega) = (-0.82, 50, 4)",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
