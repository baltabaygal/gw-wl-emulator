    { "type": "rectangle", "id": "secE_sub", "x": 510, "y": 2590, "width": 440, "height": 110,
      "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 24031, "version": 1, "versionNonce": 24032, "isDeleted": false,
      "groupIds": [], "boundElements": [{"id":"secE_sub_t","type":"text"}], "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "secE_sub_t", "x": 525, "y": 2600, "width": 410, "height": 90,
      "text": "subhalo spatial density  ~  x^2/(1+c x)^2 * B(x)\nB(x) depletes clumps near the\ncenter (tidal stripping)", "originalText": "subhalo spatial density  ~  x^2/(1+c x)^2 * B(x)\nB(x) depletes clumps near the\ncenter (tidal stripping)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#6d28d9", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 24033, "version": 1, "versionNonce": 24034, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "secE_sub", "lineHeight": 1.3 },

    { "type": "rectangle", "id": "secE_evid", "x": 60, "y": 2750, "width": 1000, "height": 190,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 24041, "version": 1, "versionNonce": 24042, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3} },
    { "type": "text", "id": "secE_evid_t", "x": 80, "y": 2766, "width": 960, "height": 160,
      "text": "B(x) = [1 + (x/x0)^-2.5]^-1/2,   x = r / r200\n  [x0 = transition scale, refit to Bolshoi radial bias, Klypin+11 / Green+21 Fig.7]\n\nx0 = 0.86 * eta_vir_to_200(c200, z)\n  [eta converts r_vir/r200 via c_vir^3/m(c_vir) = 200 c200^3 / (m(c200) Delta_vir(z))]",
      "originalText": "B(x) = [1 + (x/x0)^-2.5]^-1/2,   x = r / r200\n  [x0 = transition scale, refit to Bolshoi radial bias, Klypin+11 / Green+21 Fig.7]\n\nx0 = 0.86 * eta_vir_to_200(c200, z)\n  [eta converts r_vir/r200 via c_vir^3/m(c_vir) = 200 c200^3 / (m(c200) Delta_vir(z))]",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 24043, "version": 1, "versionNonce": 24044, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.5 },

