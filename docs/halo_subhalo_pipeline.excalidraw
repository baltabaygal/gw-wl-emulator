    { "type": "text", "id": "secE_host_t", "x": 80, "y": 2608, "width": 320, "height": 74,
      "text": "host mass density  ~  x^2 / (1+c x)^2\n(smooth NFW, cuspy toward center)", "originalText": "host mass density  ~  x^2 / (1+c x)^2\n(smooth NFW, cuspy toward center)",
