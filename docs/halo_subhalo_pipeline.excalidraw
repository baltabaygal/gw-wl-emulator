    { "type": "rectangle", "id": "secE_host", "x": 60, "y": 2590, "width": 360, "height": 110,
      "strokeColor": "#1e3a5f", "backgroundColor": "#dbeafe", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 24011, "version": 1, "versionNonce": 24012, "isDeleted": false,
