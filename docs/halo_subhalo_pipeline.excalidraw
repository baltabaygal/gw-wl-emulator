    { "type": "text", "id": "secI_eq_t", "x": 440, "y": 4490, "width": 720, "height": 190,
      "text": "kappa_halo = kappa_NFW[ M - Sum_i m_i - M_u ]\n              +  Sum_i kappa_NFW(m_i)  +  kappa_u\n\ngamma_halo = gamma_host  +  Sum_i gamma_i\n   (single-angle projection, matches Vaskonen's original convention)",
      "originalText": "kappa_halo = kappa_NFW[ M - Sum_i m_i - M_u ]\n              +  Sum_i kappa_NFW(m_i)  +  kappa_u\n\ngamma_halo = gamma_host  +  Sum_i gamma_i\n   (single-angle projection, matches Vaskonen's original convention)",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
